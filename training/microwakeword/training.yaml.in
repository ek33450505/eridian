# Rendered by train.sh (step: yaml); @MWW_ROOT@ is substituted.
# Notebook defaults except negative_class_weight (60 vs 20) and the extra
# confusable negative feature set. minimization_metric is null (as in the
# notebook); "ambient_false_positives_per_hour" needs a validation_ambient split
# that dinner_party_eval is not confirmed to provide.
window_step_ms: 10
train_dir: "@MWW_ROOT@/trained_models/wakeword"

features:
  - features_dir: "@MWW_ROOT@/generated_augmented_features"
    sampling_weight: 2.0
    penalty_weight: 1.0
    truth: true
    truncation_strategy: truncate_start
    type: mmap
  - features_dir: "@MWW_ROOT@/negative_datasets/speech"
    sampling_weight: 10.0
    penalty_weight: 1.0
    truth: false
    truncation_strategy: random
    type: mmap
  - features_dir: "@MWW_ROOT@/negative_datasets/dinner_party"
    sampling_weight: 10.0
    penalty_weight: 1.0
    truth: false
    truncation_strategy: random
    type: mmap
  - features_dir: "@MWW_ROOT@/negative_datasets/no_speech"
    sampling_weight: 5.0
    penalty_weight: 1.0
    truth: false
    truncation_strategy: random
    type: mmap
  # Confusable negatives (hey ricky, rocky road, ...), same augmentation as positives.
  - features_dir: "@MWW_ROOT@/generated_augmented_confusables"
    sampling_weight: 5.0
    penalty_weight: 1.0
    truth: false
    truncation_strategy: truncate_start
    type: mmap
  # Only used for validation and testing.
  - features_dir: "@MWW_ROOT@/negative_datasets/dinner_party_eval"
    sampling_weight: 0.0
    penalty_weight: 1.0
    truth: false
    truncation_strategy: split
    type: mmap

training_steps: [10000]
positive_class_weight: [1]
negative_class_weight: [60]
learning_rates: [0.001]
batch_size: 128
time_mask_max_size: [0]
time_mask_count: [0]
freq_mask_max_size: [0]
freq_mask_count: [0]
eval_step_interval: 500
clip_duration_ms: 1500
target_minimization: 0.9
minimization_metric: null
maximization_metric: average_viable_recall
